<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kamoda.analisecurricular.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Digite seu peso: "
           style="-fx-font-size: 24px; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-color: #ffff;"/>
    <TextField fx:id="campoPeso"
               style="-fx-font-size: 24px; -fx-text-fill: #696969; -fx-font-weight: bold; -fx-color: #ffff; -fx-max-width: 260px"/>
    <Label text="Digite sua altura: "
           style="-fx-font-size: 24px; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-color: #ffff"/>
    <TextField fx:id="campoAltura"
               style="-fx-font-size: 24px; -fx-text-fill: #696969; -fx-font-weight: bold; -fx-color: #ffff; -fx-max-width: 260px"/>
    <Button text="Calcular" onAction="#onHelloButtonClick"
            style="-fx-font-size: 24px; -fx-text-fill: #696969; -fx-font-weight: bold; -fx-color: #ffff"/>
    <Label fx:id="labelCalculo"
           style="-fx-font-size: 24px; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-color: #ffff"/>
    <Label fx:id="labelClassificacao"
           style="-fx-font-size: 24px; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-color: #ffff"/>
</VBox>
